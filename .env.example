NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile sitekey (public, safe to expose client-side) — guards
# signup, password reset, and the landing-page anonymous sign-in against bot
# abuse. Get one at https://dash.cloudflare.com/?to=/:account/turnstile.
# Leave unset to skip captcha entirely (forms and the anon sign-in still work,
# just unprotected). The matching Secret Key is entered in the Supabase
# dashboard (Auth > Settings > Bot and Abuse Protection), never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical public origin, used for metadata, sitemap, robots and OG links.
# Leave unset on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used automatically);
# set it once a real custom domain is live, e.g. https://thewapp.com
NEXT_PUBLIC_SITE_URL=

# Sentry (optional until the project is provisioned).
# Set NEXT_PUBLIC_SENTRY_DSN to start capturing errors/traces in every runtime.
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN are build-only and enable
# source-map upload (set them in the Vercel project env, not here).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# SERVER-ONLY (never prefix with NEXT_PUBLIC_). Used by the guest-upgrade
# route (app/api/auth/upgrade-guest) to reach the auth rate limiter
# (migration 0027). Supabase dashboard > Project Settings > API > service_role.
# Without it that route refuses upgrades (fails closed).
SUPABASE_SERVICE_ROLE_KEY=
